---
import Base from '../layouts/Base.astro';
---

<Base
  titre="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
>

  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1 class="not-found-title">Page introuvable</h1>
    <p class="error-text">
      Cette page n'existe pas ou a été déplacée.<br />
      Peut-être cherchez-vous l'une de nos créations ?
    </p>
    <div class="not-found-actions">
      <a href="/boutique" class="btn-primary">Voir la boutique</a>
      <a href="/" class="btn-secondary">Retour à l'accueil</a>
    </div>
  </div>

</Base>

<style>
  .not-found {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    text-align:     center;
    padding:        5rem 1rem;
    max-width:      32rem;
    margin:         0 auto;
  }

  .not-found-code {
    font-family:  var(--font-display, serif);
    font-size:    8rem;
    font-weight:  700;
    line-height:  1;
    color:        var(--color-border, #E2DDD5);
    margin:       0 0 1rem;
  }

  .not-found-title {
    font-family:  var(--font-display, serif);
    font-size:    clamp(1.5rem, 3vw, 2rem);
    font-weight:  600;
    margin:       0 0 1rem;
    color:        var(--color-text, #2B2D42);
  }

  .error-text {
    font-size:   1.0625rem;
    color:       var(--color-text-muted, #6B6D80);
    line-height: 1.6;
    margin:      0 0 2rem;
  }

  .not-found-actions {
    display:   flex;
    gap:       1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display:         inline-block;
    background:      var(--color-accent, #E6997C);
    color:           #fff;
    padding:         0.75rem 2rem;
    border-radius:   0.5rem;
    font-size:       0.9375rem;
    font-weight:     500;
    text-decoration: none;
    transition:      background 0.2s;
  }
  .btn-primary:hover { background: var(--color-accent-hover, #D88463); }

  .btn-secondary {
    display:         inline-block;
    background:      transparent;
    color:           var(--color-text-muted, #7A6E65);
    padding:         0.7rem 1.75rem;
    border-radius:   0.5rem;
    border:          1.5px solid var(--color-border, #E8E0D6);
    font-size:       0.9375rem;
    font-weight:     500;
    text-decoration: none;
    transition:      border-color 0.2s, color 0.2s;
  }
  .btn-secondary:hover {
    border-color: var(--color-text-muted, #7A6E65);
    color:        var(--color-text, #2A2520);
  }
</style>
