---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const aPropos = await getEntry('aPropos', 'a-propos');
const { Content } = await render(aPropos);
const { nom, photo } = aPropos.data;
---

<Base
  titre="À propos"
  description={`Découvrez l'histoire et les créations de ${nom}.`}
>

  <div class="page-header">
    <h1 class="page-title">À propos</h1>
  </div>

  <div class="about-layout">

    <!-- Photo -->
    {photo && (
      <div class="about-photo-col">
        <div class="photo-wrapper">
          <img
            src={photo}
            alt={`Photo de ${nom}`}
            class="about-photo"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    )}

    <!-- Texte -->
    <div class={`about-content-col ${!photo ? 'no-photo' : ''}`}>
      <div class="about-text">
        <Content />
      </div>
      <a href="/boutique" class="btn-primary">Voir les créations</a>
    </div>

  </div>

</Base>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family: var(--font-display, serif);
    font-size:   clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    margin:      0;
    color:       var(--color-text, #2B2D42);
  }

  /* Layout */
  .about-layout {
    display:     grid;
    gap:         3rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .about-layout {
      grid-template-columns: 18rem 1fr;
    }
  }

  @media (min-width: 1024px) {
    .about-layout {
      grid-template-columns: 22rem 1fr;
    }
  }

  /* Photo */
  .photo-wrapper {
    border-radius: 0.75rem;
    overflow:      hidden;
    border:        1px solid var(--color-border, #E2DDD5);
    aspect-ratio:  3 / 4;
    background:    var(--color-bg, #FDFBF7);
  }

  .about-photo {
    width:      100%;
    height:     100%;
    object-fit: cover;
    display:    block;
  }

  /* Contenu */
  .about-content-col {
    display:        flex;
    flex-direction: column;
    gap:            1.5rem;
  }

  .about-content-col.no-photo {
    max-width: 42rem;
  }

  .about-name {
    font-family:  var(--font-display, serif);
    font-size:    clamp(1.5rem, 3vw, 2rem);
    font-weight:  600;
    margin:       0;
    color:        var(--color-text, #2B2D42);
  }

  /* Texte Markdown */
  .about-text {
    font-size:   1rem;
    line-height: 1.75;
    color:       var(--color-text, #2B2D42);
  }

  .about-text :global(p)            { margin: 0 0 1em; }
  .about-text :global(p:last-child) { margin-bottom: 0; }
  .about-text :global(h2),
  .about-text :global(h3) {
    font-family:  var(--font-display, serif);
    font-weight:  600;
    margin:       1.5em 0 0.5em;
    color:        var(--color-text, #2B2D42);
  }
  .about-text :global(ul),
  .about-text :global(ol) {
    padding-left: 1.25em;
    margin:       0 0 1em;
  }
  .about-text :global(strong) {
    font-weight: 600;
    color:       var(--color-text, #2B2D42);
  }

  /* Bouton */
  .btn-primary {
    display:         inline-block;
    align-self:      flex-start;
    background:      var(--color-accent, #E6997C);
    color:           #fff;
    padding:         0.7rem 1.75rem;
    border-radius:   0.5rem;
    font-size:       0.9375rem;
    font-weight:     500;
    text-decoration: none;
    transition:      background 0.2s, transform 0.1s;
  }
  .btn-primary:hover  { background: var(--color-accent-hover, #D88463); }
  .btn-primary:active { transform: translateY(1px); }

  @media (max-width: 767px) {
    .photo-wrapper { aspect-ratio: 1 / 1; }
  }
</style>
