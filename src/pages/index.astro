---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getEntry, getCollection } from 'astro:content';

// Charger le singleton accueil
const accueil = await getEntry('accueil', 'accueil');
const refs    = accueil?.data.articlesVedette ?? [];

// Résoudre les slugs en entrées complètes, ignorer les refs cassées.
// Puis compléter automatiquement avec les articles marqués vedette: true.
const tous = await getCollection('article');
const depuisAccueil = refs
  .map(({ article: slug }) => tous.find(a => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => a !== undefined);

const dejaSelectionnes = new Set(depuisAccueil.map((a) => a.id));
const automatiques = tous.filter(
  (a) => a.data.vedette && !dejaSelectionnes.has(a.id)
);

const articlesVedette = [...depuisAccueil, ...automatiques];
---

<Base
  titre="TheLeb Créations"
  description="Créations faites main avec amour — bavoirs, lingettes, accessoires et plus."
>

  <!-- -------------------------------------------------------------------- -->
  <!-- Hero                                                                  -->
  <!-- -------------------------------------------------------------------- -->
  <div class="hs-shell">
    <div class="hs-inner">
      <div class="hs-left">
        <h1 class="hero-title">
          Des créations uniques<br />
          <em>pour les petits et les grands</em>
        </h1>
        <p class="hero-description">
          Chaque pièce est cousue à la main, dans des tissus soigneusement
          choisis. <br />
          Bavoirs, lingettes, sacs, accessoires — découvrez notre
          collection.
        </p>
      </div>
      <div class="hs-right">
        <p class="hero-eyebrow">Fait main<br />avec amour</p>
        <a href="/boutique" class="btn-primary">Découvrir la collection</a>
      </div>
    </div>
    <div class="hs-trust">
      <div class="hs-trust-item">
        <span class="hs-trust-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/>
            <line x1="20" y1="4" x2="8.12" y2="15.88"/>
            <line x1="14.47" y1="14.48" x2="20" y2="20"/>
            <line x1="8.12" y1="8.12" x2="12" y2="12"/>
          </svg>
        </span>
        <span class="hs-trust-text">
          <strong>Fait main</strong>
          <span class="hs-trust-desc">Cousu à la main, pièce par pièce</span>
        </span>
      </div>
      <div class="hs-trust-item">
        <span class="hs-trust-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </span>
        <span class="hs-trust-text">
          <strong>Pièces uniques</strong>
          <span class="hs-trust-desc">Petites séries et créations exclusives</span>
        </span>
      </div>
      <div class="hs-trust-item">
        <span class="hs-trust-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
          </svg>
        </span>
        <span class="hs-trust-text">
          <strong>Tissus choisis</strong>
          <span class="hs-trust-desc">Matières soigneusement sélectionnées</span>
        </span>
      </div>
    </div>
  </div>

  <!-- -------------------------------------------------------------------- -->
  <!-- Articles en vedette                                                   -->
  <!-- -------------------------------------------------------------------- -->
  {articlesVedette.length > 0 && (
    <section class="featured-section">
      <div class="section-header">
        <h2 class="section-title">Nos créations</h2>
        <a href="/boutique" class="section-link">Voir tout le catalogue →</a>
      </div>

      <div class="articles-grid">
        {articlesVedette.map(article => (
          <ArticleCard
            slug={article.id}
            titre={article.data.titre}
            prix={article.data.prix}
            statut={article.data.statut}
            images={article.data.images}
            categorie={article.data.categorie}
            theme={article.data.theme}
            quantite={article.data.quantite}
          />
        ))}
      </div>

      <div class="featured-cta">
        <a href="/boutique" class="btn-secondary">Voir tout le catalogue</a>
      </div>
    </section>
  )}

  <!-- -------------------------------------------------------------------- -->
  <!-- Bandeau "À propos" rapide                                             -->
  <!-- -------------------------------------------------------------------- -->
  <section class="about-strip">
    <div class="about-strip-content">
      <p class="about-strip-text">
        Toutes nos créations sont <strong>faites main</strong>, en petite série
        ou en pièce unique. Vous ne trouvez pas ce que vous cherchez ?
      </p>
      <a href="/contact" class="btn-primary">Contactez-nous</a>
    </div>
  </section>

</Base>

<style>
  /* ------------------------------------------------------------------ */
  /* Hero                                                                 */
  /* ------------------------------------------------------------------ */
  /* Hero shell */
  .hs-shell {
    border:        1px solid var(--color-border, #E2DDD5);
    border-radius: 0.75rem;
    overflow:      hidden;
    margin-bottom: 2rem;
  }

  .hs-inner {
    display:     flex;
    align-items: stretch;
  }

  .hs-left {
    flex:      2;
    min-width: 0;
    padding:   2.5rem 2rem 0rem;
  }

  .hs-right {
    flex:            1;
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    gap:             1.25rem;
    padding:         2.5rem 2rem;
    text-align:      center;
  }

  .hs-trust {
    display:    flex;
    border-top: 1px solid var(--color-border, #E2DDD5);
    background: color-mix(in srgb, var(--color-accent, #E6997C) 4%, var(--color-bg, #FDFBF7));
  }

  .hs-trust-item {
    flex:        1;
    display:     flex;
    align-items: center;
    gap:         0.75rem;
    margin:      0;
    padding:     0.875rem 1.25rem;
  }

  .hs-trust-item + .hs-trust-item {
    border-left: 1px solid var(--color-border, #E2DDD5);
  }

  .hs-trust-icon {
    flex-shrink:     0;
    width:           1.75rem;
    height:          1.75rem;
    display:         flex;
    align-items:     center;
    justify-content: center;
    border-radius:   50%;
    background:      color-mix(in srgb, var(--color-accent, #E6997C) 12%, transparent);
    color:           var(--color-accent, #E6997C);
    margin-inline:   0.375rem;
  }

  .hs-trust-icon svg {
    width:  0.95rem;
    height: 0.95rem;
  }

  .hs-trust-text {
    display:        flex;
    flex-direction: column;
    gap:            0.15rem;
  }

  .hs-trust-item strong {
    font-weight: 600;
    font-size:   0.9375rem;
    color:       var(--color-text, #2B2D42);
    margin:      0;
  }

  .hs-trust-desc {
    font-size:   0.8125rem;
    color:       var(--color-text-muted, #6B6D80);
    line-height: 1.4;
  }

  .hero-eyebrow {
    font-family:    "Sacramento", cursive;
    font-size:      3.05rem;
    font-weight:    400;
    letter-spacing: 0.01em;
    text-transform: none;
    line-height:    1;
    color:          var(--color-secondary, #739371);
    margin:         0 0 1.25rem;
    white-space:    nowrap;
  }

  .hero-title {
    font-family:  var(--font-display, serif);
    font-size:    3.1rem;
    font-weight:  600;
    line-height:  1.31;
    margin:       0 0 1.4rem;
    color:        var(--color-text, #2B2D42);
  }

  .hero-title em {
    font-style:  italic;
    font-weight: 400;
    color:       var(--color-secondary, #739371);
  }

  .hero-description {
    font-size:   1.0625rem;
    color:       var(--color-text-muted, #6B6D80);
    line-height: 1.7;
    margin:      0 0 2.1rem;
  }

  /* ------------------------------------------------------------------ */
  /* Articles en vedette                                                  */
  /* ------------------------------------------------------------------ */
  .featured-section {
    padding: 0.3rem 0 3rem;
  }

  .section-header {
    display:        flex;
    align-items:    baseline;
    justify-content: space-between;
    gap:            1rem;
    margin-bottom:  1.5rem;
    flex-wrap:      wrap;
  }

  .section-title {
    font-family:  var(--font-display, serif);
    font-size:    1.75rem;
    font-weight:  600;
    margin:       0;
    color:        var(--color-text, #2B2D42);
  }

  .section-link {
    font-size:   0.875rem;
    font-weight: 500;
    color:       var(--color-accent, #E6997C);
    transition:  color 0.2s;
    white-space: nowrap;
  }
  .section-link:hover { color: var(--color-accent-hover, #D88463); }

  .articles-grid {
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap:                   1.25rem;
  }

  .featured-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ------------------------------------------------------------------ */
  /* Bandeau à propos                                                     */
  /* ------------------------------------------------------------------ */
  .about-strip {
    background:    var(--color-surface, #fff);
    border:        1px solid var(--color-border, #E2DDD5);
    border-radius: 0.75rem;
    padding:       2rem 1.5rem;
    margin-top:    1rem;
  }

  .about-strip-content {
    display:        flex;
    align-items:    center;
    justify-content: space-between;
    gap:            1.5rem;
    flex-wrap:      wrap;
  }

  .about-strip-text {
    font-size:  1rem;
    color:      var(--color-text-muted, #6B6D80);
    margin:     0;
    flex:       1;
    min-width:  16rem;
    line-height: 1.6;
  }

  /* ------------------------------------------------------------------ */
  /* Boutons                                                              */
  /* ------------------------------------------------------------------ */
  .btn-primary {
    display:         inline-block;
    background:      var(--color-accent, #E6997C);
    color:           #fff;
    padding:         0.7rem 1.75rem;
    border-radius:   0.5rem;
    font-weight:     500;
    text-decoration: none;
    transition:      background 0.2s, transform 0.1s;
    white-space:     nowrap;
  }
  .btn-primary:hover  { background: var(--color-accent-hover, #D88463); }
  .btn-primary:active { transform: translateY(1px); }

  .btn-secondary {
    display:         inline-block;
    background:      transparent;
    color:           var(--color-secondary, #739371);
    padding:         0.65rem 1.75rem;
    border-radius:   0.5rem;
    border:          1.5px solid var(--color-secondary, #739371);
    font-size:       0.9375rem;
    font-weight:     500;
    text-decoration: none;
    transition:      background 0.2s, color 0.2s;
  }
  .btn-secondary:hover {
    background: var(--color-secondary, #739371);
    color:      #fff;
  }

  /* ------------------------------------------------------------------ */
  /* Responsive                                                           */
  /* ------------------------------------------------------------------ */
  @media (max-width: 640px) {
    .hs-inner {
      flex-direction: column;
    }

    .hs-right {
      flex:        unset;
      padding-top: 1.5rem;
    }

    .hs-trust {
      flex-direction: column;
    }

    .hs-trust-item + .hs-trust-item {
      border-left:  none;
      border-top:   1px solid var(--color-border, #E2DDD5);
    }

    .hero-eyebrow {
      white-space: normal;
    }

    .about-strip-content {
      flex-direction: column;
      text-align:     center;
    }
  }

</style>
