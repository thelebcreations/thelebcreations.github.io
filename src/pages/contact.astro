---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Base
  titre="Contact"
  description="Contactez-nous pour commander un article, signaler votre intérêt ou poser une question."
>

  <div class="page-header">
    <h1 class="page-title">Contact</h1>
    <p class="page-subtitle">
      Une question, une commande, une création sur mesure ?<br />
      Écrivez-nous, nous vous répondrons rapidement.
    </p>
  </div>

  <div class="contact-layout">

    <!-- Formulaire -->
    <div class="contact-form-col">
      <ContactForm />
    </div>

    <!-- Informations complémentaires -->
    <aside class="contact-info-col">

      <div class="info-card">
        <h2 class="info-title">Fabrication sur demande</h2>
        <p class="info-text">
          Vous avez repéré un article vendu ou réservé ? Pas de panique —
          la plupart de nos créations peuvent être reproduites dans un
          tissu identique ou similaire. Indiquez-le nous dans votre message.
        </p>
      </div>

      <div class="info-card">
        <h2 class="info-title">Délais de réponse</h2>
        <p class="info-text">
          Nous répondons généralement sous 24 à 48 heures.
        </p>
      </div>

      <div class="info-card">
        <h2 class="info-title">Créations personnalisées</h2>
        <p class="info-text">
          Vous souhaitez un article dans un tissu particulier, aux couleurs
          d'un thème spécifique ? Décrivez-nous votre idée, nous étudierons
          votre demande avec plaisir.
        </p>
      </div>

    </aside>

  </div>

</Base>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-family:  var(--font-display, serif);
    font-size:    clamp(1.75rem, 4vw, 2.5rem);
    font-weight:  600;
    margin:       0 0 0.5rem;
    color:        var(--color-text, #2A2520);
  }

  .page-subtitle {
    font-size:   1rem;
    color:       var(--color-text-muted, #6B6D80);
    margin:      0;
    line-height: 1.6;
  }

  /* Layout deux colonnes */
  .contact-layout {
    display:     grid;
    gap:         3rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr 18rem;
    }
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr 22rem;
    }
  }

  /* Colonne infos */
  .contact-info-col {
    display:        flex;
    flex-direction: column;
    gap:            1rem;
  }

  .info-card {
    background:    var(--color-surface, #fff);
    border:        1px solid var(--color-border, #E2DDD5);
    border-radius: 0.75rem;
    padding:       1.25rem 1.375rem;
  }

  .info-title {
    font-family:  var(--font-display, serif);
    font-size:    1rem;
    font-weight:  600;
    margin:       0 0 0.5rem;
    color:        var(--color-text, #2A2520);
  }

  .info-text {
    font-size:   0.875rem;
    color:       var(--color-text-muted, #6B6D80);
    margin:      0;
    line-height: 1.6;
  }
</style>
