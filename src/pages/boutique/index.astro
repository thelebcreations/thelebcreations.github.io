---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CatalogueFilters from '../../components/CatalogueFilters.astro';
import { getCollection } from 'astro:content';
import {
  CATEGORIE_OPTIONS,
  THEME_OPTIONS,
  STATUT_OPTIONS,
} from '../../../tina/options';

const articles = await getCollection('article');

// Listes dédupliquées pour les selects des filtres
const categoryValues = new Set(articles.map(a => a.data.categorie));
const categories = CATEGORIE_OPTIONS.filter(({ value }) => categoryValues.has(value));
const themeValues = new Set(articles.map(a => a.data.theme));
const themes = THEME_OPTIONS.filter(({ value }) => themeValues.has(value));
const statuts = STATUT_OPTIONS;
---

<Base
  titre="Boutique"
  description="Découvrez toutes nos créations faites main — bavoirs, lingettes, accessoires et plus."
>

  <div class="page-header">
    <h1 class="page-title">Boutique</h1>
    <p class="page-subtitle">
      {articles.length} création{articles.length > 1 ? 's' : ''} faite{articles.length > 1 ? 's' : ''} main
    </p>
  </div>

  {articles.length === 0 ? (
    <!-- Catalogue vide -->
    <div class="empty-state">
      <p class="empty-title">Bientôt disponible</p>
      <p class="empty-text">
        Nous préparons de nouvelles créations. Revenez bientôt ou
        <a href="/contact">contactez-nous</a> pour être informé(e).
      </p>
    </div>
  ) : (
    <>
      <CatalogueFilters categories={categories} themes={themes} statuts={statuts} />

      <div id="catalogue-grid" class="articles-grid">
        {articles.map(article => (
          <div
            data-slug={article.id}
            data-categorie={article.data.categorie}
            data-theme={article.data.theme}
            data-statut={article.data.statut}
            data-prix={article.data.prix}
          >
            <ArticleCard
              slug={article.id}
              titre={article.data.titre}
              prix={article.data.prix}
              statut={article.data.statut}
              images={article.data.images}
              categorie={article.data.categorie}
              theme={article.data.theme}
              quantite={article.data.quantite}
            />
          </div>
        ))}
      </div>

      <!-- Message aucun résultat -->
      <p id="no-results" class="no-results" hidden>
        Aucun article ne correspond à ces filtres.
        <button id="reset-inline" class="reset-inline-btn">Effacer les filtres</button>
      </p>
    </>
  )}

</Base>

<script>
  // Synchroniser le bouton "Effacer" inline avec celui des filtres
  const resetInline = document.getElementById('reset-inline');
  const resetMain   = document.getElementById('reset-filters') as HTMLButtonElement | null;

  resetInline?.addEventListener('click', () => {
    resetMain?.click();
  });

  // Afficher/masquer le message "aucun résultat"
  // CatalogueFilters gère l'affichage des cards — on observe les changements
  const noResults  = document.getElementById('no-results') as HTMLParagraphElement;
  const grid       = document.getElementById('catalogue-grid') as HTMLElement;

  if (grid && noResults) {
    const observer = new MutationObserver(() => {
      const visibleCards = grid.querySelectorAll<HTMLElement>('[data-slug]:not([hidden])');
      noResults.hidden = visibleCards.length > 0;
    });

    observer.observe(grid, { subtree: true, attributeFilter: ['hidden'] });
  }
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    font-family: var(--font-display, serif);
    font-size:   clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    margin:      0 0 0.375rem;
    color:       var(--color-text, #2B2D42);
  }

  .page-subtitle {
    font-size: 0.9375rem;
    color:     var(--color-text-muted, #6B6D80);
    margin:    0;
  }

  .articles-grid {
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap:                   1.25rem;
  }

  /* État vide */
  .empty-state {
    text-align:    center;
    padding:       4rem 1rem;
    background:    var(--color-surface, #fff);
    border:        1px solid var(--color-border, #E2DDD5);
    border-radius: 0.75rem;
  }

  .empty-title {
    font-family:  var(--font-display, serif);
    font-size:    1.375rem;
    font-weight:  600;
    margin:       0 0 0.75rem;
    color:        var(--color-text, #2B2D42);
  }

  .empty-text {
    font-size: 0.9375rem;
    color:     var(--color-text-muted, #6B6D80);
    margin:    0;
  }

  .empty-text a {
    color:           var(--color-accent, #E6997C);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Aucun résultat */
  .no-results {
    text-align:  center;
    padding:     3rem 1rem;
    font-size:   0.9375rem;
    color:       var(--color-text-muted, #6B6D80);
    grid-column: 1 / -1;
  }

  .reset-inline-btn {
    background:      none;
    border:          none;
    color:           var(--color-accent, #E6997C);
    font-size:       inherit;
    font-family:     inherit;
    cursor:          pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding:         0;
    margin-left:     0.25rem;
  }
</style>
