---
import "../styles/global.css";
import SearchModal from "../components/SearchModal.astro";

interface Props {
  titre: string;
  description?: string;
  image?: string;
}

const {
  titre,
  description = "Créations faites main avec amour.",
  image,
} = Astro.props;

const SITE_TITLE = "TheLeb Créations";
const pageTitle = titre === SITE_TITLE ? titre : `${titre} — ${SITE_TITLE}`;

const nav = [
  { href: "/boutique", label: "La collection" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}

    <!-- Typographie -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500&family=Sacramento&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <!-- ------------------------------------------------------------------ -->
    <!-- Navigation                                                          -->
    <!-- ------------------------------------------------------------------ -->
    <header class="site-header">
      <nav class="site-nav">
        <!-- Marque -->
        <a href="/" class="brand" aria-label="Accueil TheLeb Créations">
          TheLeb <em>Créations</em>
        </a>

        <!-- Liens desktop -->
        <ul class="nav-links" role="list">
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={href} class="nav-link">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Bouton recherche -->
        <button
          id="open-search-modal"
          type="button"
          class="nav-search-btn"
          aria-label="Ouvrir la recherche"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>

        <!-- Bouton menu mobile -->
        <button
          class="nav-toggle"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>

      <!-- Menu mobile -->
      <div id="mobile-menu" class="mobile-menu" hidden>
        <ul role="list">
          {
            nav.map(({ href, label }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <!-- ------------------------------------------------------------------ -->
    <!-- Contenu principal                                                   -->
    <!-- ------------------------------------------------------------------ -->
    <main id="main-content">
      <slot />
    </main>

    <!-- ------------------------------------------------------------------ -->
    <!-- Pied de page                                                        -->
    <!-- ------------------------------------------------------------------ -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col">
          <p class="footer-brand">TheLeb <em>Créations</em></p>
          <p class="footer-tagline">Fait main<br />avec amour</p>
        </div>
        <div class="footer-col footer-col-nav">
          <ul class="footer-nav-links" role="list">
            <li><a href="/boutique">La collection</a></li>
            <li><a href="/a-propos">À propos</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
          <p class="footer-copy">&copy; {new Date().getFullYear()} TheLeb Créations</p>
        </div>
      </div>
    </footer>

    <SearchModal />
  </body>
</html>

<!-- -------------------------------------------------------------------- -->
<!-- Menu mobile — script minimal, pas de dépendances                      -->
<!-- -------------------------------------------------------------------- -->
<script>
  const toggle = document.querySelector(".nav-toggle") as HTMLButtonElement;
  const menu = document.getElementById("mobile-menu") as HTMLDivElement;

  toggle?.addEventListener("click", () => {
    const isOpen = !menu.hidden;
    menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.classList.toggle("is-open", !isOpen);
  });

  // Fermer le menu au clic sur un lien
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.classList.remove("is-open");
    });
  });
</script>

<style>
  /* -------------------------------------------------------------------------
   * Tokens de design
   * ------------------------------------------------------------------------ */
  /* -------------------------------------------------------------------------
   * Reset minimal + base
   * ------------------------------------------------------------------------ */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0.5rem;
    z-index: 200;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .skip-link:focus {
    left: 0.5rem;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* -------------------------------------------------------------------------
   * Header & Navigation
   * ------------------------------------------------------------------------ */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header::before {
    content: "";
    display: block;
    height: 4px;
    background: var(--color-secondary);
  }

  .site-nav {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--padding-x);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Marque */
  .brand {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-text);
    transition: color 0.2s;
  }
  .brand em {
    font-style: italic;
    font-weight: 550;
    color: var(--color-secondary);
  }
  .brand:hover {
    color: var(--color-accent);
  }

  /* Liens desktop */
  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.2s;
    position: relative;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.2s ease;
  }
  .nav-link:hover {
    color: var(--color-text);
  }
  .nav-link:hover::after {
    width: 100%;
  }

  .nav-search-btn {
    display: flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 0.375rem;
    border-radius: 0.375rem;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .nav-search-btn:hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-border) 40%, transparent);
  }

  /* Bouton hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-text);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
    transform-origin: center;
  }
  .nav-toggle.is-open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle.is-open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Menu mobile */
  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    padding: 1rem var(--padding-x);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .mobile-menu a {
    display: block;
    padding: 0.75rem 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    transition: color 0.2s;
  }
  .mobile-menu a:hover {
    color: var(--color-accent);
  }
  .mobile-menu li:last-child a {
    border-bottom: none;
  }

  /* -------------------------------------------------------------------------
   * Contenu principal
   * ------------------------------------------------------------------------ */
  #main-content {
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 1.5rem var(--padding-x) 4rem;
  }

  /* -------------------------------------------------------------------------
   * Footer
   * ------------------------------------------------------------------------ */
  .site-footer {
    border-top:  1px solid var(--color-border);
    background:  color-mix(in srgb, var(--color-accent) 4%, var(--color-bg));
  }

  .footer-inner {
    max-width:     var(--max-width);
    margin-inline: auto;
    padding:       0.1rem var(--padding-x);
    display:       flex;
    align-items:   stretch;
  }

  .footer-col {
    flex:    1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap:     0.5rem;
    padding: 0.2rem 1.5rem;
  }

  .footer-col-nav {
    justify-content: space-between;
    padding-top: 0.6rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size:   1.375rem;
    font-weight: 600;
    margin:      0;
    color:       var(--color-text);
  }
  .footer-brand em {
    font-style:  italic;
    font-weight: 550;
    color:       var(--color-secondary);
  }

  .footer-tagline {
    font-family: "Sacramento", cursive;
    font-size:   1.9rem;
    font-weight: 400;
    line-height: 0.75;
    color:       var(--color-secondary);
    margin:      0;
  }

  .footer-nav-links {
    list-style: none;
    margin:     0;
    padding:    0;
    display:    flex;
    flex-direction: column;
    gap:        0.35rem;
  }

  .footer-nav-links a {
    font-size:            0.9375rem;
    font-weight:          500;
    color:                var(--color-accent);
    text-decoration:      underline;
    text-underline-offset: 3px;
    transition:           color 0.2s;
  }
  .footer-nav-links a:hover {
    color: var(--color-accent-hover);
  }

  .footer-copy {
    font-size: 0.75rem;
    color:     var(--color-text-muted);
    margin:    0;
  }

  /* -------------------------------------------------------------------------
   * Responsive
   * ------------------------------------------------------------------------ */
  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
