---
import type { ArticleStatut } from '../../src/content.config';

interface Props {
  statut: ArticleStatut;
}

const { statut } = Astro.props;

const config: Record<ArticleStatut, { label: string; cls: string }> = {
  disponible: { label: 'Disponible', cls: 'badge-disponible' },
  reserve:    { label: 'Réservé',    cls: 'badge-reserve'    },
  vendu:      { label: 'Vendu',      cls: 'badge-vendu'      },
};

const { label, cls } = config[statut];
---

<span class={`status-badge ${cls}`}>{label}</span>

<style>
  .status-badge {
    display:        inline-flex;
    align-items:    center;
    padding:        0.2em 0.7em;
    border-radius:  999px;
    font-size:      0.7rem;
    font-weight:    500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge-disponible {
    background-color: var(--color-secondary, #739371);
    color:            var(--color-text, #2B2D42);
  }

  .badge-reserve {
    background-color: var(--color-highlight, #FFB703);
    color:            var(--color-text, #2B2D42);
  }

  .badge-vendu {
    background-color: var(--color-border, #E2DDD5);
    color:            var(--color-text-muted, #6B6D80);
  }
</style>
