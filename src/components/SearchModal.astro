---
// Search modal is fully client-side.
---

<div id="search-backdrop" class="search-backdrop" hidden aria-hidden="true"></div>

<div
  id="search-modal"
  class="search-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
  hidden
>
  <h2 id="search-title" class="sr-only">Recherche produits</h2>

  <div class="search-input-row">
    <svg
      class="search-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>

    <input
      id="search-input"
      type="search"
      class="search-input"
      placeholder="Rechercher une création..."
      autocomplete="off"
      spellcheck="false"
      aria-label="Rechercher"
      aria-controls="search-results"
    />

    <button id="search-close" type="button" class="search-close" aria-label="Fermer la recherche">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div id="search-results" class="search-results" aria-live="polite">
    <p id="search-hint" class="search-state-msg">
      Saisissez un mot-clé pour rechercher parmi les créations.
    </p>

    <p id="search-min" class="search-state-msg" hidden>
      Tapez au moins 3 caractères.
    </p>

    <p id="search-loading" class="search-state-msg" hidden>Recherche...</p>

    <p id="search-empty" class="search-state-msg" hidden>
      Aucune création trouvée pour ce mot-clé.
    </p>

    <ul id="search-result-list" class="search-result-list" hidden></ul>
  </div>
</div>

<script>
  type SearchState = 'hint' | 'min' | 'loading' | 'empty' | 'results';

  const MIN_QUERY_LENGTH = 3;
  const MAX_RESULT_FETCH = 20;
  const MAX_RESULT_RENDER = 8;

  const STATUT_BOOST: Record<string, number> = {
    disponible: 2000,
    reserve: 1000,
    vendu: 0,
  };

  let pagefind: any = null;
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;
  let activeIndex = -1;
  let requestId = 0;
  let lastFocusedBeforeOpen: HTMLElement | null = null;

  const modal = document.getElementById('search-modal') as HTMLElement | null;
  const backdrop = document.getElementById('search-backdrop') as HTMLElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const closeBtn = document.getElementById('search-close') as HTMLButtonElement | null;
  const hint = document.getElementById('search-hint') as HTMLElement | null;
  const minState = document.getElementById('search-min') as HTMLElement | null;
  const loading = document.getElementById('search-loading') as HTMLElement | null;
  const empty = document.getElementById('search-empty') as HTMLElement | null;
  const resultList = document.getElementById('search-result-list') as HTMLUListElement | null;

  if (
    !modal ||
    !backdrop ||
    !input ||
    !closeBtn ||
    !hint ||
    !minState ||
    !loading ||
    !empty ||
    !resultList
  ) {
    throw new Error('SearchModal initialization failed: required elements are missing.');
  }

  const modalEl = modal!;
  const backdropEl = backdrop!;
  const inputEl = input!;
  const closeBtnEl = closeBtn!;
  const hintEl = hint!;
  const minStateEl = minState!;
  const loadingEl = loading!;
  const emptyEl = empty!;
  const resultListEl = resultList!;

  function showState(state: SearchState) {
    hintEl.hidden = state !== 'hint';
    minStateEl.hidden = state !== 'min';
    loadingEl.hidden = state !== 'loading';
    emptyEl.hidden = state !== 'empty';
    resultListEl.hidden = state !== 'results';
  }

  function resetResults() {
    resultListEl.innerHTML = '';
    resultListEl.hidden = true;
    activeIndex = -1;
  }

  function getFocusableElements() {
    const all = modalEl.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );

    return Array.from(all).filter((el) => {
      if (el.hasAttribute('hidden')) {
        return false;
      }
      return el.offsetParent !== null || el === document.activeElement;
    });
  }

  function openModal(trigger?: HTMLElement) {
    lastFocusedBeforeOpen = trigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);

    modalEl.hidden = false;
    backdropEl.hidden = false;
    backdropEl.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    inputEl.focus();
    activeIndex = -1;
  }

  function closeModal() {
    modalEl.hidden = true;
    backdropEl.hidden = true;
    backdropEl.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';

    if (debounceTimer) {
      clearTimeout(debounceTimer);
      debounceTimer = null;
    }

    requestId += 1;
    inputEl.value = '';
    resetResults();
    showState('hint');

    if (lastFocusedBeforeOpen) {
      lastFocusedBeforeOpen.focus();
      lastFocusedBeforeOpen = null;
    }
  }

  async function initPagefind(): Promise<boolean> {
    if (pagefind) {
      return true;
    }

    try {
      const pagefindModulePath = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pagefindModulePath);
      await pagefind.init();
      return true;
    } catch (e) {
      console.warn('Pagefind is unavailable. Run a full build before testing search.', e);
      pagefind = null;
      return false;
    }
  }

  function isProductUrl(url: string) {
    try {
      const parsed = new URL(url, window.location.origin);
      return (
        /^\/boutique\/[^/]+\/?$/.test(parsed.pathname) ||
        /^\/boutique\/[^/]+\/index\.html$/.test(parsed.pathname)
      );
    } catch {
      return false;
    }
  }

  function getItems() {
    return Array.from(resultListEl.querySelectorAll<HTMLLIElement>('.search-result-item'));
  }

  function setActive(index: number) {
    const items = getItems();

    items.forEach((item, i) => {
      const isActive = i === index;
      item.classList.toggle('is-active', isActive);
      item.setAttribute('aria-selected', String(isActive));
      if (isActive) {
        item.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  function renderResults(dataArr: any[]) {
    resultListEl.innerHTML = '';

    dataArr.forEach((data: any) => {
      const li = document.createElement('li');
      li.className = 'search-result-item';
      li.setAttribute('aria-selected', 'false');

      const link = document.createElement('a');
      link.className = 'search-result-link';
      link.href = data.url ?? '#';

      const rawMeta = data.meta ?? {};
      const imageMeta =
        rawMeta.image ??
        rawMeta['image[src]'] ??
        rawMeta.image_src ??
        rawMeta.imageUrl ??
        rawMeta.image_url;
      const image = typeof imageMeta === 'string' ? imageMeta.trim() : '';
      if (image) {
        const thumbWrap = document.createElement('span');
        thumbWrap.className = 'search-result-thumb-wrap';

        const thumb = document.createElement('img');
        thumb.className = 'search-result-thumb';
        thumb.src = image;
        thumb.alt = '';
        thumb.setAttribute('loading', 'lazy');
        thumb.setAttribute('decoding', 'async');

        thumbWrap.appendChild(thumb);
        link.appendChild(thumbWrap);
        link.classList.add('has-thumb');
      }

      const content = document.createElement('div');
      content.className = 'search-result-content';

      const title = document.createElement('span');
      title.className = 'search-result-title';
      title.textContent = data.meta?.title ?? data.url ?? 'Résultat';

      const excerpt = document.createElement('span');
      excerpt.className = 'search-result-excerpt';
      excerpt.innerHTML = typeof data.excerpt === 'string' ? data.excerpt : '';

      if (!excerpt.textContent?.trim()) {
        excerpt.textContent = 'Voir la fiche produit';
      }

      content.appendChild(title);
      content.appendChild(excerpt);
      link.appendChild(content);
      link.addEventListener('click', () => closeModal());

      li.appendChild(link);
      resultListEl.appendChild(li);
    });
  }

  async function runSearch(rawQuery: string) {
    const query = rawQuery.trim();
    const currentRequest = ++requestId;

    if (!query) {
      resetResults();
      showState('hint');
      return;
    }

    if (query.length < MIN_QUERY_LENGTH) {
      resetResults();
      showState('min');
      return;
    }

    showState('loading');

    const ready = await initPagefind();
    if (currentRequest !== requestId) {
      return;
    }

    if (!ready) {
      resetResults();
      showState('empty');
      return;
    }

    let search: any;
    try {
      search = await pagefind.search(query);
    } catch (e) {
      if (currentRequest !== requestId) {
        return;
      }
      console.warn('Search query failed.', e);
      resetResults();
      showState('empty');
      return;
    }

    if (currentRequest !== requestId) {
      return;
    }

    if (!search?.results?.length) {
      resetResults();
      showState('empty');
      return;
    }

    const candidates = search.results.slice(0, MAX_RESULT_FETCH);

    const rows = await Promise.all(
      candidates.map(async (result: any) => ({
        score: Number(result.score) || 0,
        data: await result.data(),
      }))
    );

    if (currentRequest !== requestId) {
      return;
    }

    const ranked = rows
      .filter((row) => isProductUrl(row.data?.url ?? ''))
      .sort((a, b) => {
        const aBoost = STATUT_BOOST[a.data?.meta?.statut ?? ''] ?? 0;
        const bBoost = STATUT_BOOST[b.data?.meta?.statut ?? ''] ?? 0;
        return bBoost + b.score - (aBoost + a.score);
      })
      .slice(0, MAX_RESULT_RENDER);

    if (ranked.length === 0) {
      resetResults();
      showState('empty');
      return;
    }

    renderResults(ranked.map((row) => row.data));
    showState('results');
    activeIndex = -1;
  }

  inputEl.addEventListener('input', () => {
    if (debounceTimer) {
      clearTimeout(debounceTimer);
    }
    debounceTimer = setTimeout(() => {
      void runSearch(inputEl.value);
    }, 280);
  });

  inputEl.addEventListener('keydown', (e) => {
    const items = getItems();

    if (e.key === 'ArrowDown') {
      if (items.length === 0) {
        return;
      }
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      setActive(activeIndex);
      return;
    }

    if (e.key === 'ArrowUp') {
      if (items.length === 0) {
        return;
      }
      e.preventDefault();
      activeIndex = activeIndex <= 0 ? 0 : activeIndex - 1;
      setActive(activeIndex);
      return;
    }

    if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      items[activeIndex]?.querySelector<HTMLAnchorElement>('a')?.click();
    }
  });

  closeBtnEl.addEventListener('click', closeModal);
  backdropEl.addEventListener('click', closeModal);

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const trigger = target?.closest('#open-search-modal') as HTMLElement | null;

    if (!trigger) {
      return;
    }

    event.preventDefault();
    openModal(trigger);
  });

  document.addEventListener('keydown', (e) => {
    if (modalEl.hidden) {
      return;
    }

    if (e.key === 'Escape') {
      e.preventDefault();
      closeModal();
      return;
    }

    if (e.key !== 'Tab') {
      return;
    }

    const focusable = getFocusableElements();
    if (focusable.length === 0) {
      e.preventDefault();
      return;
    }

    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    const current = document.activeElement as HTMLElement | null;

    if (e.shiftKey) {
      if (current === first || current === modalEl) {
        e.preventDefault();
        last.focus();
      }
      return;
    }

    if (current === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(43, 45, 66, 0.45);
    z-index: 200;
    backdrop-filter: blur(3px);
  }

  .search-modal {
    position: fixed;
    top: 5rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(92vw, 42rem);
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e2ddd5);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(43, 45, 66, 0.15);
    z-index: 201;
    overflow: hidden;
    max-height: calc(100dvh - 7rem);
    display: flex;
    flex-direction: column;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border, #e2ddd5);
    flex-shrink: 0;
  }

  .search-icon {
    color: var(--color-text-muted, #6e7385);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    font-family: var(--font-body, sans-serif);
    color: var(--color-text, #2b2d42);
    background: transparent;
  }

  .search-input::placeholder {
    color: var(--color-text-muted, #6e7385);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    display: flex;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted, #6e7385);
    padding: 0.25rem;
    border-radius: 0.375rem;
    transition: color 0.15s, background 0.15s;
    flex-shrink: 0;
  }

  .search-close:hover {
    color: var(--color-text, #2b2d42);
    background: var(--color-bg, #fdfbf7);
  }

  .search-results {
    overflow-y: auto;
    max-height: 28rem;
    padding: 0.5rem 0;
  }

  .search-state-msg {
    font-size: 0.875rem;
    color: var(--color-text-muted, #6e7385);
    text-align: center;
    padding: 1.5rem 1rem;
    margin: 0;
  }

  :global(.search-result-list) {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  :global(.search-result-item) {
    margin: 0;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border, #e2ddd5);
    background: var(--color-surface, #ffffff);
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      background 0.15s;
  }

  :global(.search-result-item.is-active),
  :global(.search-result-item:hover) {
    border-color: var(--color-accent, #e6997c);
    background: var(--color-bg, #fdfbf7);
    box-shadow: 0 6px 18px rgba(43, 45, 66, 0.08);
  }

  :global(.search-result-link) {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 0.875rem;
    padding: 0.75rem 0.875rem;
    text-decoration: none;
    color: inherit;
  }

  :global(.search-result-link.has-thumb) {
    grid-template-columns: 4.5rem minmax(0, 1fr);
  }

  :global(.search-result-link:focus-visible) {
    outline: 2px solid var(--color-accent, #e6997c);
    outline-offset: 2px;
    border-radius: 0.625rem;
  }

  :global(.search-result-thumb-wrap) {
    width: 4.5rem;
    aspect-ratio: 3 / 4;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border, #e2ddd5);
    background: var(--color-bg, #fdfbf7);
  }

  :global(.search-result-thumb) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  :global(.search-result-content) {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  :global(.search-result-title) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text, #2b2d42);
    line-height: 1.35;
  }

  :global(.search-result-excerpt) {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #6e7385);
    line-height: 1.55;
  }

  :global(.search-result-excerpt mark) {
    background: color-mix(in srgb, var(--color-accent, #e6997c) 20%, transparent);
    color: var(--color-text, #2b2d42);
    border-radius: 2px;
    padding: 0 2px;
  }

  @media (max-width: 640px) {
    .search-modal {
      top: 0;
      width: 100%;
      max-width: 100%;
      border-radius: 0 0 1rem 1rem;
      border-top: none;
    }
  }
</style>
